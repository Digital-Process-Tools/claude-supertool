        "replace",
        "replace_lines",
        "paste",
        "vim"
      ],
      "rollback_on_fail": true,
      "timeout": 10
    },
    "yaml-check-yaml": {
      "cmd": "{python} {supertool_dir}/validators/yaml-check/yaml-check.py {file}",
      "match": "*.yaml",
      "hooks_into": [
        "edit",
        "replace",
        "replace_lines",
        "paste",
        "vim"
      ],
      "rollback_on_fail": true,
