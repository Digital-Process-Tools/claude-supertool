      ],
      "rollback_on_fail": false,
      "timeout": 30,
      "tier": "slow"
    },
    "tsc-check-tsx": {
      "cmd": "{python} {supertool_dir}/validators/tsc-check/tsc-check.py {file}",
      "match": "*.tsx",
      "hooks_into": [
