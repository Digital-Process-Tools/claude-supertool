{
  "repo": "Digital-Process-Tools/claude-supertool",
  "default_branch": "master",
  "branch_pattern": "fix/{issue}",
  "test_command": "pytest",
  "version_sites": [
    ".claude-plugin/plugin.json",
    "_supertool.py",
    "pyproject.toml",
    "CHANGELOG.md",
    "README.md"
  ],
  "changelog_dir": "changelog.d",
  "changelog_untagged": ["0.19.0", "0.18.0", "0.17.0", "0.16.0", "0.15.0", "0.14.0", "0.11.0"],
  "docs_targets": [
    "README.md"
  ],
  "labels": {
    "priority": [
      "priority-high",
      "priority-medium",
      "priority-low"
    ],
    "lanes": [
      "lane-watch",
      "lane-tracker-ops",
      "lane-validators",
      "lane-ci-cost",
      "lane-containment",
      "lane-release",
      "lane-git-ops"
    ]
  },
  "milestones": [
    "backlog"
  ],
  "release": {
    "tag_pattern": "v{version}",
    "create_release": true,
    "draft": false,
    "latest": true,
    "merge_method": "squash",
    "commit_subject": null,
    "triggers": {
      "merged_prs": 10,
      "soak_hours": 48
    }
  }
}
