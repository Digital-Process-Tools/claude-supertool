#!/bin/bash
# Pre-push hook: run the full test suite before allowing a push.
# Enable once per clone with: git config core.hooksPath .githooks

set -e

cd "$(git rev-parse --show-toplevel)"

# Git exports its repo pointers to every hook (GIT_DIR, GIT_INDEX_FILE, ...).
# Tests that shell out to git would inherit them and operate on THIS repo
# instead of their own tmp_path fixture — fixture commits landing on master,
# core.bare flipped to true, index desynced (#416). Drop them before pytest.
# The cd above already resolved the toplevel; anything that still needs the
# repo rediscovers it from cwd. Reported, not silent: a scrub that leaves no
# trace hides the fact that the caller leaked in the first place.
# The list is supertool.GIT_ENV_VARS, kept in sync by a test rather than by
# memory (#692 widened it: GIT_COMMON_DIR and GIT_NAMESPACE redirect too).
# Bash cannot import it, so tests/test_git_env_scrub_692.py pins the `unset`
# line below to the Python tuple and goes red the day they diverge.
leaked=""
for var in GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE; do
    if [ -n "${!var:-}" ]; then
        leaked="$leaked $var"
    fi
done
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE
if [ -n "$leaked" ]; then
    echo "── pre-push: scrubbed inherited git env from the test run:$leaked (#416) ──"
fi

# Interpreter resolution (#572). The bare name `python3` is never run. On
# Windows, PATH resolution of that exact name can hit the App Execution Alias
# stub, which *blocks* rather than erroring — inside `git push` that presents
# as a slow remote, not as a broken hook. On POSIX it loses more quietly: it
# runs whatever `python3` PATH names that day rather than the interpreter whose
# environment has the test dependencies, so the suite gating the push is not
# the suite the author has been running. Per #570, only the bare name is
# aliased on Windows; `pythonX.Y` is not, so a versioned name is safe to try.
#
# An explicit PYTHON= is used verbatim and never verified. It is the author's
# choice of interpreter, and resolution that could override it would hide which
# interpreter the suite actually ran under.
#
# An activated venv is preferred over any name on PATH, and it has to be:
# newest-first over versioned names would otherwise pick a system python3.13
# over the 3.11 venv the author has pytest installed in — swapping a correct
# interpreter for a plausible one, which is the POSIX half of this very bug.
#
# "Resolved" means it ran, not that the name is on PATH. `command -v` is
# answered by a stale symlink into a deleted venv; believing it substitutes a
# broken interpreter for a working one and reports the result as a test
# failure. Each candidate is executed once before being committed to — the same
# "ask the binary, do not believe the filename" rule the syntax-floor ladder
# uses (docs/contributing.md).
CANDIDATES=(python3.14 python3.13 python3.12 python3.11 python3.10 python3.9)
if [ -n "${VIRTUAL_ENV:-}" ]; then
    CANDIDATES=("$VIRTUAL_ENV/bin/python3" "$VIRTUAL_ENV/Scripts/python.exe" "${CANDIDATES[@]}")
fi

if [ -z "${PYTHON:-}" ]; then
    tried=""
    for candidate in "${CANDIDATES[@]}"; do
        tried="$tried $candidate"
        if command -v "$candidate" >/dev/null 2>&1 \
                && "$candidate" -c 'import sys' >/dev/null 2>&1; then
            PYTHON="$candidate"
            break
        fi
    done
fi

if [ -z "${PYTHON:-}" ]; then
    echo "✗ pre-push: no runnable Python interpreter found. Push aborted." >&2
    echo "  tried, in order:$tried" >&2
    echo "  Each candidate must be on PATH *and* execute — a name that resolves is not enough." >&2
    echo "  The bare name 'python3' is never tried: on Windows it can resolve to the App" >&2
    echo "  Execution Alias stub, which blocks forever inside 'git push' (#572)." >&2
    echo "  Fix: activate your venv, or name one — PYTHON=/path/to/venv/bin/python3 git push" >&2
    exit 1
fi

# Which refs is this push updating? A pre-push hook is handed one line per ref
# on stdin: `<local ref> <local sha> <remote ref> <remote sha>`. The suite is a
# gate worth three minutes when the destination is `master`, where a red default
# branch is a shared cost nobody opted into. Pushing a feature branch is the
# opposite trade: the PR runs 19 checks in parallel on somebody else's machine
# while the author keeps working, so running them here first buys nothing except
# a serial wait. CI being slower in wall-clock does not matter when it costs the
# author no waiting at all.
#
# The skip is disclosed rather than silent, and it names the way to override it —
# a gate that quietly stops gating is worse than one that was never there.
target_protected=0
saw_ref=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    saw_ref=1
    case "$remote_ref" in
        refs/heads/master|refs/heads/main) target_protected=1 ;;
    esac
done

# Three states, not two — and zero ref lines is two different things (#1242).
#
# Git invokes this hook with `<remote-name> <remote-url>` in argv, always. So
# when there are no ref lines AND git is the caller, the refs were read fine
# and there are none: that is what an already-up-to-date `git push` looks like,
# and git runs the hook for it anyway. Nothing is being updated, so there is
# nothing to gate — and gating it cost the full suite. Measured 2026-08-12 with
# this hook's branches marked: a second `git-push` on a pushed feature branch
# took the "could not read" arm and went on to ~296s of pytest, against
# `_PUSH_TIMEOUT = 300` in presets/git/push.py. That four-second margin is the
# coin flip #1242 was filed about, and the suite was authorising a transfer of
# nothing. An absence the tool produced, read as an absence in the world.
#
# With no argv, the caller is not git and the question really was never
# answered — some callers invoke the hook with stdin closed. That used to run
# the suite, on "being wrong that way costs three minutes and the other way
# costs master". #1802 retired that arm, because the reasoning inverts the odds
# it rests on: the arm fires exactly when the destination is *unknown*, and the
# destination of a push in this repo is overwhelmingly a feature branch, which
# #893 already decided is not worth gating. It was spending ~5 minutes,
# serially, on the author's machine, on one platform out of CI's three, to gate
# a push it had no reason to believe was going anywhere shared — in a suite
# that rewrites the index of the live worktree it runs in.
#
# The state is still reported and still distinct from the other two: "I could
# not establish the destination" is not "there is nothing to push" and not
# "this is a feature branch". #1242's split stands; only the verdict moved.
#
# The override is asked inside each state rather than ahead of both, so the
# banner still names which state it overrode. Hoisting it would print one
# message for both, which is #1242's conflation rebuilt one layer up.
if [ "$saw_ref" -eq 0 ]; then
    if [ "$#" -lt 2 ]; then
        if [ -n "${PREPUSH_FULL:-}" ]; then
            echo "── pre-push: could not read the push refs, but PREPUSH_FULL=1 — running the suite ──"
        else
            echo "── pre-push: could not read the push refs from stdin — suite NOT run here ──"
            echo "   git always runs this hook with '<remote-name> <remote-url>' in argv, and"
            echo "   this call had none, so the caller is not git and the destination is"
            echo "   unknown. Unknown is not master (#1802): this arm used to spend the"
            echo "   whole suite on every scripted push regardless of its target. CI gates"
            echo "   the commit on all three platforms either way."
            echo "   Force it locally with: PREPUSH_FULL=1 git push"
            exit 0
        fi
    elif [ -n "${PREPUSH_FULL:-}" ]; then
        echo "── pre-push: no refs to update, but PREPUSH_FULL=1 — running the suite ──"
    else
        echo "── pre-push: no refs to update — nothing to push, suite NOT run here ──"
        echo "   git ran this hook for remote '$1' and sent no ref lines, which is"
        echo "   what an up-to-date push looks like. Nothing moves, so nothing is gated."
        echo "   Force it locally with: PREPUSH_FULL=1 git push"
        exit 0
    fi
elif [ "$target_protected" -eq 0 ] && [ -z "${PREPUSH_FULL:-}" ]; then
    echo "── pre-push: feature branch — suite NOT run here ──"
    echo "   The PR's checks are the gate, and they run in parallel while you work."
    echo "   Force it locally with: PREPUSH_FULL=1 git push"
    exit 0
fi

echo "── pre-push: running full test suite (mirrors CI) ──"
# Mirror the CI gate (.github/workflows/tests.yml): as of #891 that no longer
# runs the `slow` marker — CI moved those tests to a scheduled workflow
# instead of running them on every push, and this hook mirrors CI rather than
# the local default in isolation. Do NOT gate coverage (--no-cov): CI is the
# authority on what's mergeable, and gating coverage here — which CI
# doesn't — only produces local-only false aborts.
#
# `benchmark` is the one marker excluded rather than included (#485). Those
# tests assert on elapsed wall-clock, so they can fail because the laptop was
# busy — which here means refusing a push, ~110s in, for a reason the author
# cannot act on and on a diff that could not have caused it. Three aborts in
# one night across two work streams, none of them touching the code timed.
# Excluding them costs nothing against CI either: the only wall-clock
# benchmarks in the suite read an absolute path in one maintainer's home
# directory and skip everywhere else, so CI has never run them. Ask for them
# deliberately, on a machine whose load you control: `pytest -m benchmark -n0`.
#
# `-X utf8` mirrors the workflow, which carries it deliberately (#546), and
# #1875 is what its absence here cost: the hook and CI disagreed about the one
# flag that decides how a non-ASCII failure message is rendered, and the hook
# is the exposed half — CI's Windows leg has the flag, a local `git push` did
# not. pytest writes failure lines on a stream whose codec is the console
# codepage; where that codec cannot carry the character, pytest's own
# `TerminalWriter.write_raw` fallback degrades it to a backslash-u escape, and
# a Windows console that substitutes instead of raising destroys it outright as
# U+FFFD (the before-state #546 measured). `-X` and NOT `PYTHONUTF8` /
# `PYTHONIOENCODING`: a flag applies to this interpreter only, an env var is
# inherited by every subprocess the suite spawns — including the tests that
# reproduce Windows encoding defects precisely by leaving the environment
# alone. Pinned by `tests/test_prepush_utf8_mode_1875.py`.
if ! "$PYTHON" -X utf8 -m pytest -m 'not slow and not benchmark' --no-cov --tb=short; then
    echo ""
    echo "✗ Tests failed. Push aborted."
    echo "  Fix failures or run: git push --no-verify  (to bypass, discouraged)"
    exit 1
fi

echo "✓ Tests passed. Pushing."
