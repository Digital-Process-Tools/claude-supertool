#!/bin/bash
# Pre-push hook: run the full test suite before allowing a push.
# Enable once per clone with: git config core.hooksPath .githooks

set -e

cd "$(git rev-parse --show-toplevel)"

# Git exports its repo pointers to every hook (GIT_DIR, GIT_INDEX_FILE, ...).
# Tests that shell out to git would inherit them and operate on THIS repo
# instead of their own tmp_path fixture — fixture commits landing on master,
# core.bare flipped to true, index desynced (#416). Drop them before pytest.
# The cd above already resolved the toplevel; anything that still needs the
# repo rediscovers it from cwd. Reported, not silent: a scrub that leaves no
# trace hides the fact that the caller leaked in the first place.
leaked=""
for var in GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES; do
    if [ -n "${!var:-}" ]; then
        leaked="$leaked $var"
    fi
done
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
if [ -n "$leaked" ]; then
    echo "── pre-push: scrubbed inherited git env from the test run:$leaked (#416) ──"
fi

# Interpreter resolution (#572). The bare name `python3` is never run. On
# Windows, PATH resolution of that exact name can hit the App Execution Alias
# stub, which *blocks* rather than erroring — inside `git push` that presents
# as a slow remote, not as a broken hook. On POSIX it loses more quietly: it
# runs whatever `python3` PATH names that day rather than the interpreter whose
# environment has the test dependencies, so the suite gating the push is not
# the suite the author has been running. Per #570, only the bare name is
# aliased on Windows; `pythonX.Y` is not, so a versioned name is safe to try.
#
# An explicit PYTHON= is used verbatim and never verified. It is the author's
# choice of interpreter, and resolution that could override it would hide which
# interpreter the suite actually ran under.
#
# An activated venv is preferred over any name on PATH, and it has to be:
# newest-first over versioned names would otherwise pick a system python3.13
# over the 3.11 venv the author has pytest installed in — swapping a correct
# interpreter for a plausible one, which is the POSIX half of this very bug.
#
# "Resolved" means it ran, not that the name is on PATH. `command -v` is
# answered by a stale symlink into a deleted venv; believing it substitutes a
# broken interpreter for a working one and reports the result as a test
# failure. Each candidate is executed once before being committed to — the same
# "ask the binary, do not believe the filename" rule the syntax-floor ladder
# uses (docs/contributing.md).
CANDIDATES=(python3.14 python3.13 python3.12 python3.11 python3.10 python3.9)
if [ -n "${VIRTUAL_ENV:-}" ]; then
    CANDIDATES=("$VIRTUAL_ENV/bin/python3" "$VIRTUAL_ENV/Scripts/python.exe" "${CANDIDATES[@]}")
fi

if [ -z "${PYTHON:-}" ]; then
    tried=""
    for candidate in "${CANDIDATES[@]}"; do
        tried="$tried $candidate"
        if command -v "$candidate" >/dev/null 2>&1 \
                && "$candidate" -c 'import sys' >/dev/null 2>&1; then
            PYTHON="$candidate"
            break
        fi
    done
fi

if [ -z "${PYTHON:-}" ]; then
    echo "✗ pre-push: no runnable Python interpreter found. Push aborted." >&2
    echo "  tried, in order:$tried" >&2
    echo "  Each candidate must be on PATH *and* execute — a name that resolves is not enough." >&2
    echo "  The bare name 'python3' is never tried: on Windows it can resolve to the App" >&2
    echo "  Execution Alias stub, which blocks forever inside 'git push' (#572)." >&2
    echo "  Fix: activate your venv, or name one — PYTHON=/path/to/venv/bin/python3 git push" >&2
    exit 1
fi

echo "── pre-push: running full test suite (mirrors CI) ──"
# Mirror the CI gate (.github/workflows/tests.yml): run slow tests too, and do
# NOT gate coverage (--no-cov). CI is the authority on what's mergeable; gating
# coverage here — which CI doesn't — only produces local-only false aborts, and
# the default 'not slow' filter would let a slow test that CI runs slip through.
#
# `benchmark` is the one marker excluded rather than included (#485). Those
# tests assert on elapsed wall-clock, so they can fail because the laptop was
# busy — which here means refusing a push, ~110s in, for a reason the author
# cannot act on and on a diff that could not have caused it. Three aborts in
# one night across two work streams, none of them touching the code timed.
# Excluding them costs nothing against CI either: the only wall-clock
# benchmarks in the suite read an absolute path in one maintainer's home
# directory and skip everywhere else, so CI has never run them. Ask for them
# deliberately, on a machine whose load you control: `pytest -m benchmark -n0`.
if ! "$PYTHON" -m pytest -m 'not benchmark' --no-cov --tb=short; then
    echo ""
    echo "✗ Tests failed. Push aborted."
    echo "  Fix failures or run: git push --no-verify  (to bypass, discouraged)"
    exit 1
fi

echo "✓ Tests passed. Pushing."
